APP_NAME=Hayka Content Platform
APP_TIMEZONE=Asia/Tehran
DATABASE_URL=sqlite:////var/lib/hayka/app.db
UPLOAD_DIR=/var/lib/hayka/uploads
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CONTENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_TIMEOUT_SECONDS=180
MAX_VOICE_BYTES=26214400
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_DESTINATION=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_TIMEOUT_SECONDS=30
TELEGRAM_FFMPEG_BINARY=/usr/bin/ffmpeg
TELEGRAM_SUPPORT_ENABLED=true
TELEGRAM_SUPPORT_POLL_TIMEOUT_SECONDS=20
TELEGRAM_SUPPORT_RETRY_SECONDS=3
BALE_BOT_TOKEN=
BALE_DEFAULT_DESTINATION=
BALE_TIMEOUT_SECONDS=30
BALE_SUPPORT_ENABLED=true
RUBIKA_BOT_TOKEN=
RUBIKA_DEFAULT_DESTINATION=
RUBIKA_TIMEOUT_SECONDS=30
RUBIKA_SUPPORT_ENABLED=true
RUBIKA_SUPPORT_POLL_SECONDS=5
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8780
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_BRIDGE_TOKEN_FILE=/var/lib/hayka/whatsapp-runtime/bridge-token
WHATSAPP_DEFAULT_DESTINATION=
WHATSAPP_TIMEOUT_SECONDS=60
WHATSAPP_BRIDGE_PORT=8780
WHATSAPP_SESSION_DIR=/var/lib/hayka/whatsapp-session
WHATSAPP_RUNTIME_DIR=/var/lib/hayka/whatsapp-runtime
PUBLISHING_WORKER_ENABLED=true
PUBLISHING_POLL_SECONDS=15
DEBUG=false

{
  "id": "haykaHealthMonitor01",
  "name": "Hayka - Panel health every 5 minutes",
  "active": false,
  "nodes": [
    {"id": "schedule", "name": "Every 5 minutes", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0], "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 5}]}}},
